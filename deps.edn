{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        cnuernber/dtype-next {:mvn/version "11.026"}
        org.graalvm.js/js-language {:mvn/version "25.3.4.1"}
        org.graalvm.polyglot/polyglot {:mvn/version "25.3.4.1"}
        org.graalvm.wasm/wasm-language {:mvn/version "25.3.4.1"}
        ;; The optimizing Truffle runtime JIT-compiles the wasm guest with
        ;; libgraal from the GraalVM CE 25 JDK in the flake. Without it, the
        ;; polyglot engine uses only an interpreter.
        org.graalvm.truffle/truffle-runtime {:mvn/version "25.3.4.1"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        net.willcohen/native {:mvn/version "0.0.3"}}

 :aliases {;; Develop against a clj-native checkout: clojure -A:dev ...
           :dev {:override-deps {net.willcohen/native {:local/root "../clj-native"}}}
           :build {:deps {io.github.clojure/tools.build
                         {:git/tag "v0.10.9" :git/sha "e405aac"}
                         clj-commons/pomegranate {:mvn/version "1.3.27"}}
                  :ns-default build}
           :test {:extra-paths ["test/cljc"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.1"}
                               org.clojure/data.json {:mvn/version "2.5.1"}}
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                  :main-opts ["-m" "cognitect.test-runner" "-d" "test/cljc/net"]}}}
